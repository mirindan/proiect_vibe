{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Run current file",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${file}"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Python: Run unit tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
